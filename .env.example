# ==============================================================================
# GST-Ready Accounting Ledger — Environment Configuration Example (.env.example)
# ==============================================================================
# Primary Source of Truth: docs/ARCHITECTURE.md (Section 8.3)
# Cross-Reference: docs/AGENT_LOG.md (Stage 10.5)
#
# NOTE: The core accounting application functions 100% normally without an AI key.
# Core double-entry ledger, invoice, payment, GST, and reporting features do not
# depend on AI and remain fully operational even if AI is disabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Copilot Configuration (Optional Differentiator)
# Source: docs/ARCHITECTURE.md:318-324, docs/AGENT_LOG.md:94
# ------------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

